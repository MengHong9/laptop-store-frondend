# Dev (default): leave both empty. Vite proxies /api -> http://127.0.0.1:8080
# Backend on another host/port in dev:
# VITE_PROXY_TARGET=http://127.0.0.1:8080
# Production build served from a DIFFERENT origin than the API (then the backend needs
# CORS_ALLOWED_ORIGINS=https://your-site.example). Not needed when nginx proxies /api (see Dockerfile).
# VITE_API_BASE_URL=https://api.your-domain.com
